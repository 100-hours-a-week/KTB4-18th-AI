# Copy this file to .env for local development.
# Never commit a real API key.

# 공통 실행 환경
APP_ENV=local

# 의도 분류·종합 안내 생성 — OpenRouter
OPENROUTER_LLM_API_KEY=<YOUR_OPENROUTER_LLM_API_KEY>
LLM_MODEL=openai/gpt-5.6-luna

# 음성 전사(STT) — OpenRouter 호출
OPENROUTER_STT_API_KEY=<YOUR_OPENROUTER_STT_API_KEY>
STT_MODEL=openai/whisper-large-v3-turbo

# 검색용 임베딩 — OpenRouter (DB와 같은 Gemini 모델, 3072차원)
OPENROUTER_EMBEDDING_API_KEY=<YOUR_OPENROUTER_EMBEDDING_API_KEY>
EMBEDDING_MODEL=google/gemini-embedding-2

# 음악 카탈로그 — PostgreSQL + pgvector
DATABASE_URL=<YOUR_DATABASE_URL>

# V2 사진 추천 — OpenRouter VLM. 미지정 시 사진 분석을 호출하지 않고 오류를 반환한다.
PHOTO_VLM_MODEL=
# 선택: 사진 분석 전용 OpenRouter 키. 미설정 시 OPENROUTER_LLM_API_KEY를 사용한다.
# NOTE: 텍스트 채팅과 키를 나누면 사진 쪽 한도만 조정해 폴백을 시험할 수 있다.
PHOTO_VLM_API_KEY=

# 선택: 자체 VLM 폴백 — OpenAI 호환 URL(/v1 포함)·서빙 모델·서버 인증 키
# NOTE: 세 설정이 모두 있을 때만 429·5xx·통신 실패를 한 번 우회한다. 미설정 시 원래 오류를 반환한다.
PHOTO_FALLBACK_URL=
PHOTO_FALLBACK_MODEL=
PHOTO_FALLBACK_API_KEY=