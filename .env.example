# Copy this file to .env for local development.
# Never commit a real API key.

APP_ENV=local
# 채팅 응답(LLM) 호출용. OpenRouter 워크스페이스에서 발급.
OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>
OPENROUTER_MODEL=<YOUR_OPENROUTER_MODEL_SLUG>
OPENAI_TIMEOUT_SECONDS=3
# 검색용 임베딩(gemini-embedding-2) 호출 전용. 채팅 응답과 별도 키로 발급받는다.
OPENROUTER_EMBEDDING_API_KEY=<YOUR_OPENROUTER_EMBEDDING_API_KEY>
OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-2

DATABASE_URL=<YOUR_DATABASE_URL>
